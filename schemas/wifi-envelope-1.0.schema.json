{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://network-explorer.invalid/schema/wifi-envelope-1.0.json",
 "title": "Wi-Fi Explorer canonical dataset envelope wifi-1.0",
 "description": "The Network Explorer 1.1 envelope (same fields, outcome invariants and freshness semantics) with Wi-Fi datasets. The distinct schema_version keeps a Wi-Fi envelope from ever being read as a Network Explorer dataset, and the reverse.",
 "type": "object",
 "additionalProperties": false,
 "properties": {
  "schema_version": {
   "const": "wifi-1.0"
  },
  "dataset": {
   "enum": [
    "device",
    "ap_inventory",
    "ap_state",
    "radio_inventory",
    "radio_state"
   ]
  },
  "generation_id": {
   "type": "string",
   "minLength": 1,
   "maxLength": 128
  },
  "attempted_at": {
   "type": "string",
   "format": "date-time",
   "pattern": "Z$"
  },
  "observed_at": {
   "anyOf": [
    {
     "type": "string",
     "format": "date-time",
     "pattern": "Z$"
    },
    {
     "type": "null"
    }
   ]
  },
  "status": {
   "enum": [
    "ok",
    "partial",
    "failed",
    "unsupported"
   ]
  },
  "complete": {
   "type": "boolean"
  },
  "source": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "method": {
     "enum": [
      "native_snmp",
      "python_snmp",
      "fixture",
      "agent"
     ]
    },
    "adapter": {
     "type": "string",
     "minLength": 1,
     "maxLength": 128
    },
    "version": {
     "type": "string",
     "minLength": 1,
     "maxLength": 32
    },
    "source_instance": {
     "type": "string",
     "minLength": 1,
     "maxLength": 128
    },
    "collection_mode": {
     "enum": [
      "once",
      "periodic"
     ]
    }
   },
   "required": [
    "method",
    "adapter",
    "version"
   ]
  },
  "capability": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "state": {
     "enum": [
      "supported",
      "partial",
      "unsupported",
      "unknown"
     ]
    },
    "reason": {
     "type": [
      "string",
      "null"
     ],
     "maxLength": 4096
    }
   },
   "required": [
    "state",
    "reason"
   ]
  },
  "errors": {
   "type": "array",
   "maxItems": 256,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
     "code": {
      "type": "string",
      "pattern": "^[a-z0-9_]{1,64}$"
     },
     "message": {
      "type": "string",
      "maxLength": 512
     }
    },
    "required": [
     "code",
     "message"
    ]
   }
  },
  "warnings": {
   "type": "array",
   "maxItems": 256,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
     "code": {
      "type": "string",
      "pattern": "^[a-z0-9_]{1,64}$"
     },
     "message": {
      "type": "string",
      "maxLength": 512
     }
    },
    "required": [
     "code",
     "message"
    ]
   },
   "description": "Row-level problems that did not stop the observation: the affected rows were dropped or carry unknown fields, and the rest of the dataset is complete. Allowed with any status."
  },
  "data": {
   "type": "array",
   "maxItems": 50000
  }
 },
 "required": [
  "schema_version",
  "dataset",
  "generation_id",
  "attempted_at",
  "observed_at",
  "status",
  "complete",
  "source",
  "capability",
  "errors",
  "data"
 ],
 "$defs": {
  "device": {
   "type": "object",
   "additionalProperties": false,
   "description": "The acquisition owner itself: one row. role says whether this host owns its cluster's AP, radio and SSID data.",
   "properties": {
    "hostname": {
     "type": [
      "string",
      "null"
     ],
     "maxLength": 256
    },
    "description": {
     "type": [
      "string",
      "null"
     ],
     "maxLength": 1024
    },
    "sys_object_id": {
     "type": [
      "string",
      "null"
     ],
     "pattern": "^[0-9]+(\\.[0-9]+)*$"
    },
    "vendor": {
     "type": [
      "string",
      "null"
     ],
     "maxLength": 64
    },
    "platform": {
     "type": [
      "string",
      "null"
     ],
     "pattern": "^[a-z0-9_]{1,64}$"
    },
    "role": {
     "enum": [
      "virtual_controller",
      "member",
      "controller",
      "standalone",
      "unknown"
     ]
    },
    "controller_address": {
     "type": [
      "string",
      "null"
     ],
     "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}$"
    },
    "firmware": {
     "type": [
      "string",
      "null"
     ],
     "maxLength": 128
    },
    "uptime_s": {
     "type": [
      "integer",
      "null"
     ],
     "minimum": 0,
     "maximum": 2147483648
    }
   },
   "required": [
    "hostname",
    "description",
    "sys_object_id",
    "vendor",
    "platform",
    "role",
    "controller_address",
    "firmware",
    "uptime_s"
   ]
  },
  "ap_inventory": {
   "type": "object",
   "additionalProperties": false,
   "description": "Slow-changing AP identity. ap_uid is 'ap-' and the first 24 hex digits of sha256('ap:' + MAC): stable across adapters, safe in URLs.",
   "properties": {
    "ap_uid": {
     "type": "string",
     "pattern": "^ap-[0-9a-f]{24}$"
    },
    "mac_address": {
     "type": "string",
     "pattern": "^[0-9a-f]{2}(:[0-9a-f]{2}){5}$"
    },
    "name": {
     "type": [
      "string",
      "null"
     ],
     "maxLength": 256
    },
    "ip_address": {
     "type": [
      "string",
      "null"
     ],
     "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}$"
    },
    "serial": {
     "type": [
      "string",
      "null"
     ],
     "maxLength": 128
    },
    "model": {
     "type": [
      "string",
      "null"
     ],
     "maxLength": 128
    },
    "firmware": {
     "type": [
      "string",
      "null"
     ],
     "maxLength": 128
    }
   },
   "required": [
    "ap_uid",
    "mac_address",
    "name",
    "ip_address",
    "serial",
    "model",
    "firmware"
   ]
  },
  "ap_state": {
   "type": "object",
   "additionalProperties": false,
   "description": "AP operational state keyed by ap_uid. unknown is a value: an unreadable status is never reported as up.",
   "properties": {
    "ap_uid": {
     "type": "string",
     "pattern": "^ap-[0-9a-f]{24}$"
    },
    "status": {
     "enum": [
      "up",
      "down",
      "unknown"
     ]
    },
    "uptime_s": {
     "type": [
      "integer",
      "null"
     ],
     "minimum": 0,
     "maximum": 2147483648
    },
    "cpu_percent": {
     "type": [
      "integer",
      "null"
     ],
     "minimum": 0,
     "maximum": 100
    },
    "memory_used_percent": {
     "type": [
      "number",
      "null"
     ],
     "minimum": 0,
     "maximum": 100
    }
   },
   "required": [
    "ap_uid",
    "status",
    "uptime_s",
    "cpu_percent",
    "memory_used_percent"
   ]
  },
  "radio_inventory": {
   "type": "object",
   "additionalProperties": false,
   "description": "Radio identity. radio_uid is 'radio-' and the first 24 hex digits of sha256('radio:' + AP MAC + ':' + radio index).",
   "properties": {
    "radio_uid": {
     "type": "string",
     "pattern": "^radio-[0-9a-f]{24}$"
    },
    "ap_uid": {
     "type": "string",
     "pattern": "^ap-[0-9a-f]{24}$"
    },
    "radio_index": {
     "type": "integer",
     "minimum": 0,
     "maximum": 255
    },
    "bssid": {
     "anyOf": [
      {
       "type": "string",
       "pattern": "^[0-9a-f]{2}(:[0-9a-f]{2}){5}$"
      },
      {
       "type": "null"
      }
     ]
    }
   },
   "required": [
    "radio_uid",
    "ap_uid",
    "radio_index",
    "bssid"
   ]
  },
  "radio_state": {
   "type": "object",
   "additionalProperties": false,
   "description": "Radio operational state. band is null when the evidence does not prove it; channel_width '80+' means wider than 40 MHz without a finer reading.",
   "properties": {
    "radio_uid": {
     "type": "string",
     "pattern": "^radio-[0-9a-f]{24}$"
    },
    "ap_uid": {
     "type": "string",
     "pattern": "^ap-[0-9a-f]{24}$"
    },
    "status": {
     "enum": [
      "up",
      "down",
      "unknown"
     ]
    },
    "band": {
     "enum": [
      "2.4",
      "5",
      "6",
      null
     ]
    },
    "channel": {
     "type": [
      "integer",
      "null"
     ],
     "minimum": 1,
     "maximum": 233
    },
    "channel_width": {
     "enum": [
      "20",
      "40",
      "80",
      "160",
      "80+",
      null
     ]
    },
    "tx_power_dbm": {
     "type": [
      "number",
      "null"
     ],
     "minimum": -10,
     "maximum": 40
    },
    "noise_floor_dbm": {
     "type": [
      "number",
      "null"
     ],
     "minimum": -130,
     "maximum": 0
    },
    "utilisation_percent": {
     "type": [
      "integer",
      "null"
     ],
     "minimum": 0,
     "maximum": 100
    },
    "utilisation_window_s": {
     "type": [
      "integer",
      "null"
     ],
     "minimum": 1,
     "maximum": 3600
    }
   },
   "required": [
    "radio_uid",
    "ap_uid",
    "status",
    "band",
    "channel",
    "channel_width",
    "tx_power_dbm",
    "noise_floor_dbm",
    "utilisation_percent",
    "utilisation_window_s"
   ]
  }
 },
 "allOf": [
  {
   "if": {
    "properties": {
     "dataset": {
      "const": "device"
     }
    }
   },
   "then": {
    "properties": {
     "data": {
      "items": {
       "$ref": "#/$defs/device"
      }
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "dataset": {
      "const": "ap_inventory"
     }
    }
   },
   "then": {
    "properties": {
     "data": {
      "items": {
       "$ref": "#/$defs/ap_inventory"
      }
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "dataset": {
      "const": "ap_state"
     }
    }
   },
   "then": {
    "properties": {
     "data": {
      "items": {
       "$ref": "#/$defs/ap_state"
      }
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "dataset": {
      "const": "radio_inventory"
     }
    }
   },
   "then": {
    "properties": {
     "data": {
      "items": {
       "$ref": "#/$defs/radio_inventory"
      }
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "dataset": {
      "const": "radio_state"
     }
    }
   },
   "then": {
    "properties": {
     "data": {
      "items": {
       "$ref": "#/$defs/radio_state"
      }
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "status": {
      "const": "ok"
     }
    }
   },
   "then": {
    "properties": {
     "complete": {
      "const": true
     },
     "observed_at": {
      "type": "string"
     },
     "errors": {
      "maxItems": 0
     },
     "capability": {
      "properties": {
       "state": {
        "const": "supported"
       }
      }
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "status": {
      "enum": [
       "partial",
       "failed",
       "unsupported"
      ]
     }
    }
   },
   "then": {
    "properties": {
     "complete": {
      "const": false
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "status": {
      "enum": [
       "failed",
       "unsupported"
      ]
     }
    }
   },
   "then": {
    "properties": {
     "observed_at": {
      "type": "null"
     },
     "data": {
      "maxItems": 0
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "status": {
      "const": "partial"
     }
    }
   },
   "then": {
    "properties": {
     "observed_at": {
      "type": "string"
     },
     "capability": {
      "properties": {
       "state": {
        "const": "partial"
       }
      }
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "status": {
      "const": "unsupported"
     }
    }
   },
   "then": {
    "properties": {
     "capability": {
      "properties": {
       "state": {
        "const": "unsupported"
       }
      }
     }
    }
   }
  }
 ]
}
