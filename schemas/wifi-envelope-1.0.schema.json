{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://network-explorer.invalid/schema/wifi-envelope-1.0.json",
 "title": "Wi-Fi Explorer canonical dataset envelope wifi-1.0",
 "description": "The Network Explorer 1.1 envelope (same fields, outcome invariants and freshness semantics) with Wi-Fi datasets. The distinct schema_version keeps a Wi-Fi envelope from ever being read as a Network Explorer dataset, and the reverse.",
 "type": "object",
 "additionalProperties": false,
 "properties": {
  "schema_version": {
   "const": "wifi-1.0"
  },
  "dataset": {
   "enum": [
    "device",
    "ap_inventory",
    "ap_state",
    "radio_inventory",
    "radio_state",
    "ssid",
    "rf_neighbour",
    "client"
   ]
  },
  "generation_id": {
   "type": "string",
   "minLength": 1,
   "maxLength": 128
  },
  "attempted_at": {
   "type": "string",
   "format": "date-time",
   "pattern": "Z$"
  },
  "observed_at": {
   "anyOf": [
    {
     "type": "string",
     "format": "date-time",
     "pattern": "Z$"
    },
    {
     "type": "null"
    }
   ]
  },
  "status": {
   "enum": [
    "ok",
    "partial",
    "failed",
    "unsupported"
   ]
  },
  "complete": {
   "type": "boolean"
  },
  "source": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "method": {
     "enum": [
      "native_snmp",
      "python_snmp",
      "fixture",
      "agent"
     ]
    },
    "adapter": {
     "type": "string",
     "minLength": 1,
     "maxLength": 128
    },
    "version": {
     "type": "string",
     "minLength": 1,
     "maxLength": 32
    },
    "source_instance": {
     "type": "string",
     "minLength": 1,
     "maxLength": 128
    },
    "collection_mode": {
     "enum": [
      "once",
      "periodic"
     ]
    }
   },
   "required": [
    "method",
    "adapter",
    "version"
   ]
  },
  "capability": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "state": {
     "enum": [
      "supported",
      "partial",
      "unsupported",
      "unknown"
     ]
    },
    "reason": {
     "type": [
      "string",
      "null"
     ],
     "maxLength": 4096
    }
   },
   "required": [
    "state",
    "reason"
   ]
  },
  "errors": {
   "type": "array",
   "maxItems": 256,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
     "code": {
      "type": "string",
      "pattern": "^[a-z0-9_]{1,64}$"
     },
     "message": {
      "type": "string",
      "maxLength": 512
     }
    },
    "required": [
     "code",
     "message"
    ]
   }
  },
  "warnings": {
   "type": "array",
   "maxItems": 256,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
     "code": {
      "type": "string",
      "pattern": "^[a-z0-9_]{1,64}$"
     },
     "message": {
      "type": "string",
      "maxLength": 512
     }
    },
    "required": [
     "code",
     "message"
    ]
   },
   "description": "Row-level problems that did not stop the observation: the affected rows were dropped or carry unknown fields, and the rest of the dataset is complete. Allowed with any status."
  },
  "data": {
   "type": "array",
   "maxItems": 50000
  },
  "data_rows": {
   "type": "integer",
   "minimum": 0,
   "description": "On a receipt: how many rows the observation had."
  },
  "data_omitted": {
   "const": true,
   "description": "A receipt: a complete, successful attempt stored without its rows, which are in the dataset's snapshot item. It is never read as a snapshot."
  }
 },
 "required": [
  "schema_version",
  "dataset",
  "generation_id",
  "attempted_at",
  "observed_at",
  "status",
  "complete",
  "source",
  "capability",
  "errors",
  "data"
 ],
 "$defs": {
  "device": {
   "type": "object",
   "additionalProperties": false,
   "description": "The acquisition owner itself: one row. role says whether this host owns its cluster's AP, radio and SSID data.",
   "properties": {
    "hostname": {
     "type": [
      "string",
      "null"
     ],
     "maxLength": 256
    },
    "description": {
     "type": [
      "string",
      "null"
     ],
     "maxLength": 1024
    },
    "sys_object_id": {
     "type": [
      "string",
      "null"
     ],
     "pattern": "^[0-9]+(\\.[0-9]+)*$"
    },
    "vendor": {
     "type": [
      "string",
      "null"
     ],
     "maxLength": 64
    },
    "platform": {
     "type": [
      "string",
      "null"
     ],
     "pattern": "^[a-z0-9_]{1,64}$"
    },
    "role": {
     "enum": [
      "virtual_controller",
      "member",
      "controller",
      "standalone",
      "unknown"
     ]
    },
    "controller_address": {
     "type": [
      "string",
      "null"
     ],
     "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}$"
    },
    "firmware": {
     "type": [
      "string",
      "null"
     ],
     "maxLength": 128
    },
    "uptime_s": {
     "type": [
      "integer",
      "null"
     ],
     "minimum": 0,
     "maximum": 2147483648
    }
   },
   "required": [
    "hostname",
    "description",
    "sys_object_id",
    "vendor",
    "platform",
    "role",
    "controller_address",
    "firmware",
    "uptime_s"
   ]
  },
  "ap_inventory": {
   "type": "object",
   "additionalProperties": false,
   "description": "Slow-changing AP identity. ap_uid is 'ap-' and the first 24 hex digits of sha256('ap:' + MAC): stable across adapters, safe in URLs.",
   "properties": {
    "ap_uid": {
     "type": "string",
     "pattern": "^ap-[0-9a-f]{24}$"
    },
    "mac_address": {
     "type": "string",
     "pattern": "^[0-9a-f]{2}(:[0-9a-f]{2}){5}$"
    },
    "name": {
     "type": [
      "string",
      "null"
     ],
     "maxLength": 256
    },
    "ip_address": {
     "type": [
      "string",
      "null"
     ],
     "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}$"
    },
    "serial": {
     "type": [
      "string",
      "null"
     ],
     "maxLength": 128
    },
    "model": {
     "type": [
      "string",
      "null"
     ],
     "maxLength": 128
    },
    "firmware": {
     "type": [
      "string",
      "null"
     ],
     "maxLength": 128
    }
   },
   "required": [
    "ap_uid",
    "mac_address",
    "name",
    "ip_address",
    "serial",
    "model",
    "firmware"
   ]
  },
  "ap_state": {
   "type": "object",
   "additionalProperties": false,
   "description": "AP operational state keyed by ap_uid. unknown is a value: an unreadable status is never reported as up.",
   "properties": {
    "ap_uid": {
     "type": "string",
     "pattern": "^ap-[0-9a-f]{24}$"
    },
    "status": {
     "enum": [
      "up",
      "down",
      "unknown"
     ]
    },
    "uptime_s": {
     "type": [
      "integer",
      "null"
     ],
     "minimum": 0,
     "maximum": 2147483648
    },
    "cpu_percent": {
     "type": [
      "integer",
      "null"
     ],
     "minimum": 0,
     "maximum": 100
    },
    "memory_used_percent": {
     "type": [
      "number",
      "null"
     ],
     "minimum": 0,
     "maximum": 100
    }
   },
   "required": [
    "ap_uid",
    "status",
    "uptime_s",
    "cpu_percent",
    "memory_used_percent"
   ]
  },
  "radio_inventory": {
   "type": "object",
   "additionalProperties": false,
   "description": "Radio identity. radio_uid is 'radio-' and the first 24 hex digits of sha256('radio:' + AP MAC + ':' + radio index).",
   "properties": {
    "radio_uid": {
     "type": "string",
     "pattern": "^radio-[0-9a-f]{24}$"
    },
    "ap_uid": {
     "type": "string",
     "pattern": "^ap-[0-9a-f]{24}$"
    },
    "radio_index": {
     "type": "integer",
     "minimum": 0,
     "maximum": 255
    },
    "bssid": {
     "anyOf": [
      {
       "type": "string",
       "pattern": "^[0-9a-f]{2}(:[0-9a-f]{2}){5}$"
      },
      {
       "type": "null"
      }
     ]
    }
   },
   "required": [
    "radio_uid",
    "ap_uid",
    "radio_index",
    "bssid"
   ]
  },
  "radio_state": {
   "type": "object",
   "additionalProperties": false,
   "description": "Radio operational state. band is null when the evidence does not prove it; channel_width '80+' means wider than 40 MHz without a finer reading.",
   "properties": {
    "radio_uid": {
     "type": "string",
     "pattern": "^radio-[0-9a-f]{24}$"
    },
    "ap_uid": {
     "type": "string",
     "pattern": "^ap-[0-9a-f]{24}$"
    },
    "status": {
     "enum": [
      "up",
      "down",
      "unknown"
     ]
    },
    "band": {
     "enum": [
      "2.4",
      "5",
      "6",
      null
     ]
    },
    "channel": {
     "type": [
      "integer",
      "null"
     ],
     "minimum": 1,
     "maximum": 233
    },
    "channel_width": {
     "enum": [
      "20",
      "40",
      "80",
      "160",
      "80+",
      null
     ]
    },
    "tx_power_dbm": {
     "type": [
      "number",
      "null"
     ],
     "minimum": -10,
     "maximum": 40
    },
    "noise_floor_dbm": {
     "type": [
      "number",
      "null"
     ],
     "minimum": -130,
     "maximum": 0
    },
    "utilisation_percent": {
     "type": [
      "integer",
      "null"
     ],
     "minimum": 0,
     "maximum": 100
    },
    "utilisation_window_s": {
     "type": [
      "integer",
      "null"
     ],
     "minimum": 1,
     "maximum": 3600
    }
   },
   "required": [
    "radio_uid",
    "ap_uid",
    "status",
    "band",
    "channel",
    "channel_width",
    "tx_power_dbm",
    "noise_floor_dbm",
    "utilisation_percent",
    "utilisation_window_s"
   ]
  },
  "ssid": {
   "type": "object",
   "additionalProperties": false,
   "description": "One SSID as the owner reports it. Secrets (PSKs, RADIUS secrets) are never part of this row. vlan_id and security stay null where the source does not expose them (Aruba Instant AI-AP-MIB); the SSID-to-VLAN mapping then comes from declared intent.",
   "properties": {
    "ssid_uid": {
     "type": "string",
     "pattern": "^ssid-[0-9a-f]{24}$"
    },
    "name": {
     "type": "string",
     "minLength": 1,
     "maxLength": 128
    },
    "enabled": {
     "type": [
      "boolean",
      "null"
     ]
    },
    "hidden": {
     "type": [
      "boolean",
      "null"
     ]
    },
    "client_count": {
     "type": [
      "integer",
      "null"
     ],
     "minimum": 0,
     "maximum": 100000
    },
    "vlan_id": {
     "type": [
      "integer",
      "null"
     ],
     "minimum": 1,
     "maximum": 4094
    },
    "security": {
     "type": [
      "string",
      "null"
     ],
     "maxLength": 64
    },
    "profiles": {
     "type": "integer",
     "minimum": 1,
     "maximum": 1024
    }
   },
   "required": [
    "ssid_uid",
    "name",
    "enabled",
    "hidden",
    "client_count",
    "vlan_id",
    "security",
    "profiles"
   ]
  },
  "rf_neighbour": {
   "type": "object",
   "additionalProperties": false,
   "description": "One BSSID the owner AP detects, deduplicated (strongest kept) and bounded to the strongest 500. classification is the AP's own label (ArubaRogueApType); it is evidence, not a verdict, and never means malicious.",
   "properties": {
    "bssid": {
     "type": "string",
     "pattern": "^[0-9a-f]{2}(:[0-9a-f]{2}){5}$"
    },
    "ssid": {
     "type": [
      "string",
      "null"
     ],
     "maxLength": 128
    },
    "channel": {
     "type": [
      "integer",
      "null"
     ],
     "minimum": 1,
     "maximum": 233
    },
    "band": {
     "enum": [
      "2.4",
      "5",
      "6",
      null
     ]
    },
    "channel_width": {
     "enum": [
      "20",
      "40",
      "80",
      "160",
      null
     ]
    },
    "phy": {
     "type": [
      "string",
      "null"
     ],
     "maxLength": 16
    },
    "encryption": {
     "type": [
      "string",
      "null"
     ],
     "maxLength": 64
    },
    "snr_db": {
     "type": [
      "integer",
      "null"
     ],
     "minimum": 0,
     "maximum": 120
    },
    "classification": {
     "enum": [
      "valid",
      "interfering",
      "unsecure",
      "dos",
      "unknown",
      "known_interfering",
      "suspected_unsecure",
      "other",
      null
     ]
    },
    "classification_raw": {
     "type": [
      "string",
      "null"
     ],
     "maxLength": 64
    }
   },
   "required": [
    "bssid",
    "ssid",
    "channel",
    "band",
    "channel_width",
    "phy",
    "encryption",
    "snr_db",
    "classification",
    "classification_raw"
   ]
  },
  "client": {
   "type": "object",
   "additionalProperties": false,
   "description": "One associated client, masked at collection by the owner's {$WE.CLIENT.IDENTIFIERS} policy: full keeps MAC, IP address and name; partial keeps the MAC's manufacturer prefix only; pseudonymised keeps only the keyed client_uid. ap_uid comes from the client's AP address matched against the AP table in the same walk.",
   "properties": {
    "client_uid": {
     "type": "string",
     "pattern": "^client-[0-9a-f]{24}$"
    },
    "mac_address": {
     "type": [
      "string",
      "null"
     ],
     "pattern": "^[0-9a-f]{2}(:[0-9a-f]{2}){2}:([0-9a-f]{2}:[0-9a-f]{2}:[0-9a-f]{2}|xx:xx:xx)$"
    },
    "ip_address": {
     "type": [
      "string",
      "null"
     ],
     "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}$"
    },
    "name": {
     "type": [
      "string",
      "null"
     ],
     "maxLength": 256
    },
    "identifiers": {
     "enum": [
      "full",
      "partial",
      "pseudonymised"
     ]
    },
    "ap_uid": {
     "type": [
      "string",
      "null"
     ],
     "pattern": "^ap-[0-9a-f]{24}$"
    },
    "ap_basis": {
     "enum": [
      "ap_address",
      "ap_address_unmatched",
      null
     ]
    },
    "bssid": {
     "type": [
      "string",
      "null"
     ],
     "pattern": "^[0-9a-f]{2}(:[0-9a-f]{2}){5}$"
    },
    "snr_db": {
     "type": [
      "integer",
      "null"
     ],
     "minimum": 0,
     "maximum": 120
    },
    "connected_s": {
     "type": [
      "integer",
      "null"
     ],
     "minimum": 0,
     "maximum": 2147483648
    }
   },
   "required": [
    "client_uid",
    "mac_address",
    "ip_address",
    "name",
    "identifiers",
    "ap_uid",
    "ap_basis",
    "bssid",
    "snr_db",
    "connected_s"
   ]
  }
 },
 "allOf": [
  {
   "if": {
    "properties": {
     "dataset": {
      "const": "device"
     }
    }
   },
   "then": {
    "properties": {
     "data": {
      "items": {
       "$ref": "#/$defs/device"
      }
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "dataset": {
      "const": "ap_inventory"
     }
    }
   },
   "then": {
    "properties": {
     "data": {
      "items": {
       "$ref": "#/$defs/ap_inventory"
      }
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "dataset": {
      "const": "ap_state"
     }
    }
   },
   "then": {
    "properties": {
     "data": {
      "items": {
       "$ref": "#/$defs/ap_state"
      }
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "dataset": {
      "const": "radio_inventory"
     }
    }
   },
   "then": {
    "properties": {
     "data": {
      "items": {
       "$ref": "#/$defs/radio_inventory"
      }
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "dataset": {
      "const": "radio_state"
     }
    }
   },
   "then": {
    "properties": {
     "data": {
      "items": {
       "$ref": "#/$defs/radio_state"
      }
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "dataset": {
      "const": "ssid"
     }
    }
   },
   "then": {
    "properties": {
     "data": {
      "items": {
       "$ref": "#/$defs/ssid"
      }
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "dataset": {
      "const": "rf_neighbour"
     }
    }
   },
   "then": {
    "properties": {
     "data": {
      "items": {
       "$ref": "#/$defs/rf_neighbour"
      }
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "dataset": {
      "const": "client"
     }
    }
   },
   "then": {
    "properties": {
     "data": {
      "items": {
       "$ref": "#/$defs/client"
      }
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "status": {
      "const": "ok"
     }
    }
   },
   "then": {
    "properties": {
     "complete": {
      "const": true
     },
     "observed_at": {
      "type": "string"
     },
     "errors": {
      "maxItems": 0
     },
     "capability": {
      "properties": {
       "state": {
        "const": "supported"
       }
      }
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "status": {
      "enum": [
       "partial",
       "failed",
       "unsupported"
      ]
     }
    }
   },
   "then": {
    "properties": {
     "complete": {
      "const": false
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "status": {
      "enum": [
       "failed",
       "unsupported"
      ]
     }
    }
   },
   "then": {
    "properties": {
     "observed_at": {
      "type": "null"
     },
     "data": {
      "maxItems": 0
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "status": {
      "const": "partial"
     }
    }
   },
   "then": {
    "properties": {
     "observed_at": {
      "type": "string"
     },
     "capability": {
      "properties": {
       "state": {
        "const": "partial"
       }
      }
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "status": {
      "const": "unsupported"
     }
    }
   },
   "then": {
    "properties": {
     "capability": {
      "properties": {
       "state": {
        "const": "unsupported"
       }
      }
     }
    }
   }
  }
 ]
}
