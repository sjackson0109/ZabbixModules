{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "dataset": {
      "enum": [
        "interfaces",
        "device",
        "lldp",
        "lag",
        "port_capability",
        "vlan",
        "stp"
      ]
    },
    "generation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "attempted_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "observed_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "ok",
        "partial",
        "failed",
        "unsupported"
      ]
    },
    "complete": {
      "type": "boolean"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method": {
          "enum": [
            "native_snmp",
            "python_snmp",
            "fixture",
            "agent"
          ]
        },
        "adapter": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "source_instance": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "collection_mode": {
          "enum": [
            "once",
            "periodic"
          ]
        }
      },
      "required": [
        "method",
        "adapter",
        "version"
      ]
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "supported",
            "partial",
            "unsupported",
            "unknown"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        }
      },
      "required": [
        "state",
        "reason"
      ]
    },
    "errors": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[a-z0-9_]{1,64}$"
          },
          "message": {
            "type": "string",
            "maxLength": 512
          }
        },
        "required": [
          "code",
          "message"
        ]
      }
    },
    "warnings": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[a-z0-9_]{1,64}$"
          },
          "message": {
            "type": "string",
            "maxLength": 512
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "description": "Row-level problems that did not stop the observation: the affected rows were dropped or carry unknown fields, and the rest of the dataset is complete. Allowed with any status."
    },
    "data": {
      "type": "array",
      "maxItems": 50000
    }
  },
  "required": [
    "schema_version",
    "dataset",
    "generation_id",
    "attempted_at",
    "observed_at",
    "status",
    "complete",
    "source",
    "capability",
    "errors",
    "data"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://network-explorer.invalid/schema/envelope-1.1.json",
  "title": "Network Explorer canonical dataset envelope 1.1",
  "$defs": {
    "interfaces": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "uid": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
        },
        "if_index": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "name": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        },
        "description": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        },
        "type": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "physical": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "admin_status": {
          "enum": [
            "up",
            "down",
            "testing",
            null
          ]
        },
        "oper_status": {
          "enum": [
            "up",
            "down",
            "testing",
            "unknown",
            "dormant",
            "not_present",
            "lower_layer_down",
            null
          ]
        },
        "speed_bps": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "duplex": {
          "enum": [
            "half",
            "full",
            null
          ]
        },
        "mtu": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "mac_address": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        },
        "member": {
          "type": [
            "string",
            "integer",
            "null"
          ]
        },
        "slot": {
          "type": [
            "string",
            "integer",
            "null"
          ]
        },
        "port": {
          "type": [
            "string",
            "integer",
            "null"
          ]
        },
        "expected_speed_bps": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "alias": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        },
        "last_change": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "media": {
          "enum": [
            "copper",
            "sfp",
            "sfp_plus",
            "sfp28",
            "qsfp",
            "virtual",
            "other",
            null
          ]
        },
        "stack_parent_uid": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "uid",
        "if_index",
        "name",
        "description",
        "type",
        "physical",
        "admin_status",
        "oper_status",
        "speed_bps",
        "duplex",
        "mtu",
        "mac_address"
      ]
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hostname": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        },
        "vendor": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        },
        "model": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        },
        "firmware": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        },
        "chassis_ids": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "subtype",
              "value"
            ],
            "properties": {
              "subtype": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1,
                "maximum": 7
              },
              "value": {
                "type": "string",
                "maxLength": 4096
              }
            }
          }
        },
        "management_addresses": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "string",
            "maxLength": 255
          },
          "uniqueItems": true
        },
        "sys_object_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]+(\\.[0-9]+)*$"
        },
        "sys_name": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        },
        "description": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        },
        "serial": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        },
        "uptime_s": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "stack_members": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "member",
              "model",
              "serial",
              "firmware"
            ],
            "properties": {
              "member": {
                "type": [
                  "string",
                  "integer"
                ]
              },
              "model": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 4096
              },
              "serial": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 4096
              },
              "firmware": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 4096
              },
              "role": {
                "enum": [
                  "master",
                  "standby",
                  "member",
                  "unknown",
                  null
                ]
              }
            }
          }
        }
      },
      "required": [
        "hostname",
        "vendor",
        "model",
        "firmware",
        "chassis_ids",
        "management_addresses"
      ]
    },
    "lldp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "local_interface_uid": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "local_port_id": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "subtype",
            "value"
          ],
          "properties": {
            "subtype": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 7
            },
            "value": {
              "type": "string",
              "maxLength": 4096
            }
          }
        },
        "remote_chassis_id": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "subtype",
            "value"
          ],
          "properties": {
            "subtype": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 7
            },
            "value": {
              "type": "string",
              "maxLength": 4096
            }
          }
        },
        "remote_port_id": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "subtype",
            "value"
          ],
          "properties": {
            "subtype": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 7
            },
            "value": {
              "type": "string",
              "maxLength": 4096
            }
          }
        },
        "remote_system_name": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        },
        "remote_port_description": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        },
        "remote_management_addresses": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "string",
            "maxLength": 255
          },
          "uniqueItems": true
        },
        "observed_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "local_if_index": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "source_index": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "description": "timeMark.localPortNum.remIndex"
        },
        "remote_system_description": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "supported",
            "enabled"
          ],
          "properties": {
            "supported": {
              "anyOf": [
                {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "enum": [
                      "other",
                      "repeater",
                      "bridge",
                      "wlan_access_point",
                      "router",
                      "telephone",
                      "docsis",
                      "station",
                      "c_vlan",
                      "s_vlan",
                      "tpmr"
                    ]
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "enabled": {
              "anyOf": [
                {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "enum": [
                      "other",
                      "repeater",
                      "bridge",
                      "wlan_access_point",
                      "router",
                      "telephone",
                      "docsis",
                      "station",
                      "c_vlan",
                      "s_vlan",
                      "tpmr"
                    ]
                  }
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "remote_advertised_speeds_bps": {
          "anyOf": [
            {
              "type": "array",
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "null = unknown; [] = known to advertise nothing"
        },
        "remote_oper_speed_bps": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "remote_duplex": {
          "enum": [
            "half",
            "full",
            null
          ]
        },
        "remote_lag": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "aggregated",
                "port_id"
              ],
              "properties": {
                "aggregated": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                },
                "port_id": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "remote_pvid": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 4094
        },
        "protocol": {
          "enum": [
            "lldp",
            "cdp"
          ]
        }
      },
      "required": [
        "local_interface_uid",
        "local_port_id",
        "remote_chassis_id",
        "remote_port_id",
        "remote_system_name",
        "remote_port_description",
        "remote_management_addresses",
        "observed_at"
      ]
    },
    "lag": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "uid": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
        },
        "name": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        },
        "if_index": {
          "type": "integer",
          "minimum": 1
        },
        "member_interface_uids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
          },
          "maxItems": 4096
        },
        "oper_status": {
          "enum": [
            "up",
            "down",
            "testing",
            "unknown",
            "dormant",
            "not_present",
            "lower_layer_down",
            null
          ]
        },
        "actor_system_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        },
        "partner_system_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        },
        "mode": {
          "enum": [
            "lacp",
            "static",
            "pagp",
            "unknown",
            null
          ]
        },
        "members": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "uid",
              "selected",
              "collecting",
              "distributing"
            ],
            "properties": {
              "uid": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
              },
              "selected": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "collecting": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "distributing": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "lacp_active": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "partner_port": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              }
            }
          }
        }
      },
      "required": [
        "uid",
        "name",
        "if_index",
        "member_interface_uids",
        "oper_status",
        "actor_system_id",
        "partner_system_id"
      ]
    },
    "port_capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uid",
        "if_index",
        "autoneg_enabled",
        "oper_mau_type",
        "supported_speeds_bps",
        "advertised_speeds_bps",
        "partner_advertised_speeds_bps"
      ],
      "properties": {
        "uid": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
        },
        "if_index": {
          "type": "integer",
          "minimum": 1
        },
        "autoneg_enabled": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "oper_mau_type": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]+(\\.[0-9]+)*$"
        },
        "oper_speed_bps": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "oper_duplex": {
          "enum": [
            "half",
            "full",
            null
          ]
        },
        "supported_speeds_bps": {
          "anyOf": [
            {
              "type": "array",
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "null = unknown; [] = known to advertise nothing"
        },
        "advertised_speeds_bps": {
          "anyOf": [
            {
              "type": "array",
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "null = unknown; [] = known to advertise nothing"
        },
        "partner_advertised_speeds_bps": {
          "anyOf": [
            {
              "type": "array",
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "null = unknown; [] = known to advertise nothing"
        },
        "media": {
          "enum": [
            "copper",
            "sfp",
            "sfp_plus",
            null
          ],
          "description": "Optional. Port media from the operating MAU type, or from the supported MAU types when they all share one media."
        }
      }
    },
    "vlan": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "vlan_id",
            "name",
            "state"
          ],
          "properties": {
            "kind": {
              "const": "vlan"
            },
            "vlan_id": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4094
            },
            "name": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 4096
            },
            "state": {
              "enum": [
                "permanent",
                "dynamic",
                "other",
                "unknown"
              ]
            },
            "bridge_domain": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 4096
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "interface_uid",
            "bridge_port",
            "mode",
            "pvid",
            "tagged",
            "untagged",
            "forbidden",
            "source"
          ],
          "properties": {
            "kind": {
              "const": "port"
            },
            "interface_uid": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "bridge_port": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "mode": {
              "enum": [
                "access",
                "trunk",
                "hybrid",
                "unknown"
              ]
            },
            "pvid": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 4094
            },
            "tagged": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^$|^[0-9]{1,4}(-[0-9]{1,4})?(,[0-9]{1,4}(-[0-9]{1,4})?)*$",
              "maxLength": 20000,
              "description": "VLAN ID ranges, e.g. '1,10-20,49'; null = unknown"
            },
            "untagged": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^$|^[0-9]{1,4}(-[0-9]{1,4})?(,[0-9]{1,4}(-[0-9]{1,4})?)*$",
              "maxLength": 20000,
              "description": "VLAN ID ranges, e.g. '1,10-20,49'; null = unknown"
            },
            "forbidden": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^$|^[0-9]{1,4}(-[0-9]{1,4})?(,[0-9]{1,4}(-[0-9]{1,4})?)*$",
              "maxLength": 20000,
