{
  "comment": "Single source for the Wi-Fi Explorer native SNMP producers: templates/generate_wifi.py and the Node tests both read this file. Each producer's script list is composed in order, exactly as Zabbix runs it. Every walk includes sysUpTime (the agent check) and the ownership gate it needs. The Generic AP producers read standard MIBs only; the Aruba Instant producers are the first vendor templates.",
  "templates": {
    "Generic AP": {
      "name": "Wi-Fi Explorer - Generic AP",
      "uuid_scope": "Wi-Fi Explorer - Generic AP",
      "description": "Any access point that implements the standard MIBs: SNMPv2-MIB, IF-MIB, the IEEE 802.11 MIB (IEEE802dot11-MIB), ENTITY-MIB, HOST-RESOURCES-MIB and IP-MIB. Link it to one host per AP, at the AP's own address; vendor templates complement it with what no standard MIB carries (associated clients, measured channel utilisation, noise floor, RF neighbours, cluster rosters). An agent without the IEEE 802.11 MIB reports every dataset as unsupported (not_wifi_ap) rather than an empty AP. Never link it beside a vendor Wi-Fi template that already lists the same AP.",
      "capacity": [
        "we.capacity.aps.up",
        "we.capacity.aps.down",
        "we.capacity.radios.up"
      ],
      "macros": [
        {
          "macro": "{$WE.CAPACITY.HISTORY}",
          "value": "7d",
          "description": "How long the numeric capacity values (AP and radios up) are kept as history."
        },
        {
          "macro": "{$WE.CAPACITY.TRENDS}",
          "value": "365d",
          "description": "How long hourly trends of the capacity values are kept; the Capacity tab's daily and monthly views read them."
        }
      ]
    },
    "Aruba Instant VC": {
      "description": "Aruba Instant cluster inventory and state from AI-AP-MIB, read from the elected virtual controller. Link it to one host per cluster, pointed at the cluster's floating virtual controller (AVC) address. On a member AP every AP and radio dataset reports unsupported (not_virtual_controller) instead of an empty site.",
      "macros": [
        {
          "macro": "{$WE.CLIENT.IDENTIFIERS}",
          "value": "partial",
          "description": "Client identifiers kept in the client snapshot: full (MAC, IP address and name), partial (manufacturer prefix of the MAC only) or pseudonymised (keyed client ID only; needs {$WE.CLIENT.KEY}). Applied before anything is stored."
        },
        {
          "macro": "{$WE.CLIENT.KEY}",
          "value": "",
          "type": "SECRET_TEXT",
          "description": "Secret key for client IDs. Set it (as a secret macro on the host or globally) so client IDs cannot be reversed by trying every MAC address. Changing it changes every client ID."
        },
        {
          "macro": "{$WE.CAPACITY.HISTORY}",
          "value": "7d",
          "description": "How long the numeric capacity values (APs, radios, utilisation, clients) are kept as history."
        },
        {
          "macro": "{$WE.CAPACITY.TRENDS}",
          "value": "365d",
          "description": "How long hourly trends of the capacity values are kept; the Capacity tab's daily and monthly views read them."
        }
      ]
    },
    "Aruba Instant AP": {
      "description": "One Aruba Instant AP's own RF view from AI-AP-MIB: the neighbouring and interfering access points this AP detects (aiInterferAccessPointTable). Link it to a host per AP, pointed at that AP's own address (not the virtual controller address). Detections keep the AP's own classification; Wi-Fi Explorer never calls a detection malicious."
    }
  },
