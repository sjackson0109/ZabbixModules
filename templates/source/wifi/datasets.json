      "walk": ["1.3.6.1.2.1.1.3", "1.3.6.1.4.1.14823.2.3.3.1.1.5",
               "1.3.6.1.4.1.14823.2.3.3.1.2.2.1.1", "1.3.6.1.4.1.14823.2.3.3.1.2.2.1.2", "1.3.6.1.4.1.14823.2.3.3.1.2.2.1.3"]
    },
    {
