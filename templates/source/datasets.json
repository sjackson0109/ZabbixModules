{
  "comment": "Single source for the native SNMP templates and producers: the template generator, the Node tests and qualify.py read this file. Each raw walk includes the join columns its normaliser needs. A producer with a templates list belongs to those templates only; one without belongs to every template that has its component.",
  "templates": [
    {
      "template": "ne__generic_switch", "name": "Network Explorer - Generic Switch",
      "scope": "Network Explorer - Generic standard MIB",
      "comment": "The double underscore sorts this template and its file first. Its visible name is unchanged from 2.1.0. scope keeps the UUIDs it had as \"Network Explorer - Generic standard MIB\" (2.0.0) and \"Network Explorer - Generic Switch\" (2.1.0, 2.2.0), so importing over either renames the template in place and keeps its items, history and host links.",
      "components": ["Base", "Interfaces", "Port Capability", "LLDP", "VLAN", "STP", "LAG"], "dashboard": true,
      "description": "Link this one template to a switch that has an SNMP interface. It collects every standard-MIB dataset; datasets the device lacks report unsupported without affecting the others. Its host dashboard (Ports, Topology, Findings) needs the Network Explorer widget modules enabled; until then its widgets show as inaccessible."
    },
    {
      "template": "we_lldp_for_access_points", "name": "Wireless Explorer - LLDP for Access Points",
      "scope": "Network Explorer - LLDP for access points",
      "comment": "For access points, so named we_ and placed in the Wi-Fi Explorer template group, though it collects Network Explorer's LLDP dataset. scope keeps the UUIDs of its name up to 2.2.0, so importing over it renames the template in place.",
      "components": ["LLDP"],
      "description": "Link to a Wi-Fi access point's own host (not a switch) so Wi-Fi Explorer can confirm the AP's uplink from the AP side. It collects LLDP only. Never link it beside the Generic Switch template: both own the same keys."
    },
    {
      "template": "ne_cisco_small_business_switch", "name": "Network Explorer - Cisco Small Business Switch",
      "components": ["Base", "Interfaces", "Port Capability", "LLDP", "VLAN", "STP", "LAG", "Hardware Health"],
      "disabled": ["Port Capability"], "dashboard": true,
      "description": "Link this one template, instead of the Generic Switch, to a Cisco Small Business or Catalyst 1200/1300 switch on the 350-class firmware: SG350, SG350X, SG350XG, CBS350, C1200 and C1300. It collects everything the Generic Switch does, plus hardware health from the CISCOSB MIBs: CPU, temperature against the unit's own thresholds, and fans and power supplies per stack unit. Port capability is included but disabled, because these models do not implement MAU-MIB. The qualification matrix (docs/qualification/MATRIX.md) lists the models and firmware this has been tested on."
    },
    {
      "template": "ne_cisco_sg300_switch", "name": "Network Explorer - Cisco SG300 Switch",
      "components": ["Base", "Interfaces", "Port Capability", "LLDP", "VLAN", "STP", "LAG", "Hardware Health"],
      "disabled": ["Port Capability"], "dashboard": true,
      "description": "Link this one template, instead of the Generic Switch, to a Cisco SG300 switch on firmware 1.4. It collects everything the Generic Switch does, plus hardware health from the CISCOSB MIBs in their older 14-column layout: CPU, temperature, fans and power supplies. Port capability is included but disabled, because the SG300 does not implement MAU-MIB. The qualification matrix (docs/qualification/MATRIX.md) lists the models and firmware this has been tested on."
    },
    {
      "template": "ne_dell_n_series_switch", "name": "Network Explorer - Dell N Series Switch",
      "components": ["Base", "Interfaces", "Port Capability", "LLDP", "VLAN", "STP", "LAG", "Hardware Health"],
      "disabled": ["Port Capability"], "dashboard": true,
      "description": "Link this one template, instead of the Generic Switch, to a Dell Networking N-Series switch on DNOS 6. The N1548P and N4064 have been tested; other N-Series models use the same MIBs but are unqualified. It collects everything the Generic Switch does, plus hardware health from the DNOS and Dell-Vendor MIBs: overall status, CPU, memory, and fans, power supplies and temperature sensors per stack unit. Port capability is included but disabled, because these models do not implement MAU-MIB. Spanning tree reports unsupported: DNOS has no BRIDGE-MIB spanning tree. The qualification matrix (docs/qualification/MATRIX.md) lists the models and firmware this has been tested on."
    },
    {
      "template": "ne_dell_x_series_switch", "name": "Network Explorer - Dell X Series Switch",
      "components": ["Base", "Interfaces", "Port Capability", "LLDP", "VLAN", "STP", "LAG", "Hardware Health"],
      "disabled": ["Port Capability"], "dashboard": true,
      "description": "Link this one template, instead of the Generic Switch, to a Dell Networking X-Series switch (RADLAN-based firmware). The X1052 has been tested; other X-Series models use the same MIBs but are unqualified. It collects everything the Generic Switch does, plus hardware health from the RADLAN and Dell-Vendor MIBs: overall status, CPU, temperature, fans and power supplies. Port capability is included but disabled, because these models do not implement MAU-MIB. The qualification matrix (docs/qualification/MATRIX.md) lists the models and firmware this has been tested on."
    }
