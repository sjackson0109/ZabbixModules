    "lldpLocPortNum equals ifIndex",
    "dot3adAggIndex is readable (MAX-ACCESS not-accessible)",
    "Actor Port bitmap bit equals ifIndex without mapping",
    "maximum speed establishes intended speed",
    "proxy assignment grants frontend permissions",
    "empty table proves supported capability",
    "partial inventory may remove discovered interfaces"
  ],
