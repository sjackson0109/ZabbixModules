{
  "format_version": "1.0",
  "status": "production implementation specification; no field-qualified vendor profiles",
  "supported_target_versions": [
    "7.0",
    "7.2",
    "7.4"
  ],
  "schema_version": "1.0",
  "uid": {
    "algorithm": "sha256",
    "input_precedence": [
      "name:<trimmed ifName>",
      "description:<trimmed ifDescr>"
    ],
    "encoding": "UTF-8",
    "prefix": "if-",
    "hex_characters": 24,
    "ifindex_role": "current locator only",
    "ambiguity": "partial inventory; generation-scoped uncertainty ID never drives LLD"
  },
  "items": [
    {
      "key": "ne.device.snapshot",
      "owner": "Base",
      "kind": "canonical_success_snapshot",
      "value_type": "TEXT",
      "dataset": "device",
      "advance_when": {
        "schema_version": "1.0",
        "status": "ok",
        "complete": true
      },
      "retention": "7d initially; administrator policy",
      "production_implementation": "pending family qualification",
      "lab_implementation": "dependent from ne.device.attempt"
    },
    {
      "key": "ne.device.attempt",
      "owner": "Base",
      "kind": "latest_attempt_envelope",
      "value_type": "TEXT",
      "dataset": "device",
      "native_failure_note": "A native poll with no returned value cannot emit an attempt through preprocessing; source item state/error and age remain required.",
      "lab_implementation": "TRAP"
    },
    {
      "key": "ne.collection.status[device]",
      "owner": "Base",
      "kind": "last_emitted_attempt_status",
      "value_type": "UNSIGNED",
      "mapping": {
        "0": "ok",
        "1": "partial",
        "2": "failed",
        "3": "unsupported"
      }
    },
    {
      "key": "ne.collection.success[device]",
      "owner": "Base",
      "kind": "last_complete_observed_epoch",
      "value_type": "UNSIGNED",
      "units": "unixtime",
      "advance_when": {
        "status": "ok",
        "complete": true
      }
    },
    {
      "key": "ne.interfaces.inventory",
      "owner": "Interfaces",
      "kind": "canonical_success_snapshot",
      "value_type": "TEXT",
      "dataset": "interfaces",
      "advance_when": {
        "schema_version": "1.0",
        "status": "ok",
        "complete": true
      },
      "retention": "7d initially; administrator policy",
      "production_implementation": "pending family qualification",
      "lab_implementation": "dependent from ne.interfaces.attempt"
    },
    {
      "key": "ne.interfaces.state",
      "owner": "Interfaces",
      "kind": "canonical_success_snapshot",
      "value_type": "TEXT",
      "dataset": "interfaces",
      "advance_when": {
        "schema_version": "1.0",
        "status": "ok",
        "complete": true
      },
      "retention": "7d initially; administrator policy",
      "production_implementation": "pending family qualification",
      "lab_implementation": "dependent from ne.interfaces.attempt"
    },
    {
      "key": "ne.interfaces.attempt",
      "owner": "Interfaces",
      "kind": "latest_attempt_envelope",
      "value_type": "TEXT",
      "dataset": "interfaces",
      "native_failure_note": "A native poll with no returned value cannot emit an attempt through preprocessing; source item state/error and age remain required.",
      "lab_implementation": "TRAP"
    },
    {
      "key": "ne.collection.status[interfaces]",
      "owner": "Interfaces",
      "kind": "last_emitted_attempt_status",
      "value_type": "UNSIGNED",
      "mapping": {
        "0": "ok",
        "1": "partial",
        "2": "failed",
        "3": "unsupported"
      }
    },
    {
      "key": "ne.collection.success[interfaces]",
      "owner": "Interfaces",
      "kind": "last_complete_observed_epoch",
      "value_type": "UNSIGNED",
      "units": "unixtime",
      "advance_when": {
        "status": "ok",
        "complete": true
      }
    },
    {
      "key": "ne.lldp.snapshot",
      "owner": "LLDP",
      "kind": "canonical_success_snapshot",
      "value_type": "TEXT",
      "dataset": "lldp",
      "advance_when": {
        "schema_version": "1.0",
        "status": "ok",
        "complete": true
      },
      "retention": "7d initially; administrator policy",
      "production_implementation": "pending family qualification",
      "lab_implementation": "dependent from ne.lldp.attempt"
    },
    {
      "key": "ne.lldp.attempt",
      "owner": "LLDP",
      "kind": "latest_attempt_envelope",
      "value_type": "TEXT",
      "dataset": "lldp",
      "native_failure_note": "A native poll with no returned value cannot emit an attempt through preprocessing; source item state/error and age remain required.",
      "lab_implementation": "TRAP"
    },
    {
      "key": "ne.collection.status[lldp]",
      "owner": "LLDP",
      "kind": "last_emitted_attempt_status",
      "value_type": "UNSIGNED",
      "mapping": {
        "0": "ok",
        "1": "partial",
        "2": "failed",
        "3": "unsupported"
      }
    },
    {
      "key": "ne.collection.success[lldp]",
      "owner": "LLDP",
      "kind": "last_complete_observed_epoch",
      "value_type": "UNSIGNED",
      "units": "unixtime",
      "advance_when": {
        "status": "ok",
        "complete": true
      }
    },
    {
      "key": "ne.lag.snapshot",
      "owner": "LAG",
      "kind": "canonical_success_snapshot",
      "value_type": "TEXT",
      "dataset": "lag",
      "advance_when": {
        "schema_version": "1.0",
        "status": "ok",
        "complete": true
      },
      "retention": "7d initially; administrator policy",
      "production_implementation": "pending family qualification",
      "lab_implementation": "dependent from ne.lag.attempt"
    },
    {
      "key": "ne.lag.attempt",
      "owner": "LAG",
      "kind": "latest_attempt_envelope",
      "value_type": "TEXT",
      "dataset": "lag",
      "native_failure_note": "A native poll with no returned value cannot emit an attempt through preprocessing; source item state/error and age remain required.",
      "lab_implementation": "TRAP"
    },
    {
      "key": "ne.collection.status[lag]",
      "owner": "LAG",
      "kind": "last_emitted_attempt_status",
      "value_type": "UNSIGNED",
      "mapping": {
        "0": "ok",
        "1": "partial",
        "2": "failed",
        "3": "unsupported"
      }
    },
    {
      "key": "ne.collection.success[lag]",
      "owner": "LAG",
      "kind": "last_complete_observed_epoch",
      "value_type": "UNSIGNED",
      "units": "unixtime",
      "advance_when": {
        "status": "ok",
        "complete": true
      }
    },
    {
      "key": "ne.if.oper[uid]",
      "owner": "Interfaces",
      "kind": "dependent_scalar_prototype",
      "canonical_field": "oper_status",
      "unknown_scalar_sentinel": null,
      "lab_implemented": true,
      "policy_note": "Expected target must be explicitly supplied; unknown does not trigger degradation."
    },
    {
      "key": "ne.if.admin[uid]",
      "owner": "Interfaces",
      "kind": "dependent_scalar_prototype",
      "canonical_field": "admin_status",
      "unknown_scalar_sentinel": null,
      "lab_implemented": true,
      "policy_note": "Expected target must be explicitly supplied; unknown does not trigger degradation."
    },
    {
      "key": "ne.if.speed[uid]",
      "owner": "Interfaces",
      "kind": "dependent_scalar_prototype",
      "canonical_field": "speed_bps",
      "unknown_scalar_sentinel": null,
      "lab_implemented": true,
      "policy_note": "Expected target must be explicitly supplied; unknown does not trigger degradation."
    },
    {
      "key": "ne.if.duplex[uid]",
      "owner": "Interfaces",
      "kind": "dependent_scalar_prototype",
      "canonical_field": "duplex",
      "unknown_scalar_sentinel": null,
      "lab_implemented": true,
      "policy_note": "Expected target must be explicitly supplied; unknown does not trigger degradation."
    },
    {
      "key": "ne.if.expected.speed[uid]",
      "owner": "Interfaces",
      "kind": "dependent_scalar_prototype",
      "canonical_field": "expected_speed_bps",
      "unknown_scalar_sentinel": 0,
      "lab_implemented": true,
      "policy_note": "Expected target must be explicitly supplied; unknown does not trigger degradation."
    },
    {
      "key": "ne.if.degraded[uid]",
      "owner": "Interfaces",
      "kind": "dependent_scalar_prototype",
      "canonical_field": "policy-derived",
      "unknown_scalar_sentinel": null,
      "lab_implemented": false,
      "policy_note": "Expected target must be explicitly supplied; unknown does not trigger degradation."
    }
  ],
  "discovery": {
    "key": "ne.interfaces.discovery",
    "owner": "Interfaces",
    "source": "ne.interfaces.inventory",
    "required_success": true,
    "macros": {
      "{#IFUID}": "$.uid",
      "{#IFNAME}": "$.name",
      "{#IFINDEX}": "$.if_index"
    },
    "disable_absent_after": "1d confirmed complete collections",
    "delete_absent_after": "7d",
    "partial_payload": "discard; retain prior successful inventory"
  },
  "macros": [
    {
      "name": "{$NE.IF.MONITOR}",
      "default": "0",
      "meaning": "Unexpected-down alert disabled unless explicit context policy"
    },
    {
      "name": "{$NE.IF.EXPECTED_SPEED}",
      "default": "0",
      "meaning": "Unknown intended speed; not maximum capacity"
    },
    {
      "name": "{$NE.IF.EXPECTED_DUPLEX}",
      "default": "unknown",
      "meaning": "No duplex degradation inference without explicit expectation"
    },
    {
      "name": "{$NE.IF.STATE.INTERVAL}",
      "default": "60s"
    },
    {
      "name": "{$NE.IF.INVENTORY.INTERVAL}",
      "default": "1h"
    },
    {
      "name": "{$NE.LLDP.INTERVAL}",
      "default": "5m"
    },
    {
      "name": "{$NE.LAG.INTERVAL}",
      "default": "5m"
    }
  ],
